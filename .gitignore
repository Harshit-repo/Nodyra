# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/

# uv: the lockfile IS committed for reproducible builds (Docker runs
# `uv sync --locked`). Do not ignore it.

# Node
node_modules/
dist/
.vite/

# Env / secrets — never commit real values
.env
.env.local
*.local
deploy/.env

# License signing — NEVER commit the private key or the internal licensing guide.
.secrets/
*license*private*.pem
docs/licensing-internal.md

# Editor / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Nodyra runtime data
/envs/
envs/
apps/api/envs/
data/
# ...but apps/api/app/data is shipped source, not runtime data. The broad
# rule above silently swallowed twelve generated workflow templates: they
# existed locally, git add -A said nothing, and CI checked out three.
!apps/api/app/data/
!apps/api/app/data/**
*.db
*.log
.superpowers/

# Bundled tool binaries (fetched at setup, not committed)
apps/api/tools/*.exe

# Playwright e2e artifacts
apps/web/test-results/

# graphify codebase knowledge-graph output — generated, not committed (and
# packages/graphify-out/ has no pyproject.toml, which breaks `uv` if tracked
# under the packages/* workspace glob; see pyproject.toml workspace.exclude)
graphify-out/
apps/web/playwright-report/

# Ad-hoc dev screenshots / Claude Code screen captures (not project assets)
.claude-screens/
/bc-combined.png
/editor-runner-placement.png
/editor-runner-root.png
/env-modal-polish.png
/ui-after-login.png
/ui-ai-runs.png
/ui-error-run.png
/ui-executions.png
/ui-home.png
/ui-runs.png
/ui-workflow-editor.png

# Playwright MCP session artifacts
.playwright-mcp/

# Session artifacts — screenshots and scratch dirs dropped at repo root
/*.png
.tmp/
.fable5-tmp/

# Benchmark and evidence artifacts written by CI scripts into the workspace.
engine-planning-benchmark.json
engine-throughput-benchmark.json
