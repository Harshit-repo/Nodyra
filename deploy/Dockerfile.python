# Two-stage build so the final image excludes test files, dev scripts, and
# the download cache (V-03). Stage 1 installs all dependencies into a venv;
# stage 2 copies only the venv + application source into a clean base image.
#
# Build context must be the repo root:
#   docker build -f deploy/Dockerfile.python -t nodyra-api:latest .

# ── Stage 1: dependency installer ─────────────────────────────────────────────
# Chainguard Python 3.14.7 dev, pinned after vulnerability verification. Keep
# glibc support for manylinux workflow dependencies (including data packages).
FROM cgr.dev/chainguard/python:latest-dev@sha256:5f6f93d032512513505fde2128398a057fbef2e7da98e818cd8d887a6a744114 AS builder

USER root

COPY --from=ghcr.io/astral-sh/uv:0.9.30 /uv /bin/uv

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH"

WORKDIR /app

# Copy only files required by uv workspace sync (not the full source tree so
# this layer is cached when only application code changes).
COPY pyproject.toml uv.lock ./
COPY apps/api/pyproject.toml apps/api/
COPY packages/client/pyproject.toml packages/client/
COPY packages/client/LICENSE packages/client/
COPY packages/core/pyproject.toml packages/core/
COPY packages/nodes/pyproject.toml packages/nodes/
COPY packages/exporter/pyproject.toml packages/exporter/
COPY packages/runtime/pyproject.toml packages/runtime/
COPY packages/importer/pyproject.toml packages/importer/
COPY packages/runner/pyproject.toml packages/runner/

# uv needs stub __init__.py files at each package root to recognise the
# members during the dep-only install (editable installs require a dist-info).
# packages/client declares license = { file = "LICENSE" } and packages/runner
# declares readme = "README.md", so hatchling requires those metadata files to
# exist even for an editable build.
RUN for pkg in apps/api packages/client packages/core packages/nodes packages/exporter packages/runtime packages/importer packages/runner; do \
        mkdir -p "$pkg" && touch "$pkg/__init__.py"; \
    done \
    && touch packages/client/README.md packages/runner/README.md

RUN uv sync --locked --no-dev --all-packages

# ── Stage 2: production image ──────────────────────────────────────────────────
FROM cgr.dev/chainguard/python:latest-dev@sha256:5f6f93d032512513505fde2128398a057fbef2e7da98e818cd8d887a6a744114

USER root

COPY --from=ghcr.io/astral-sh/uv:0.9.30 /uv /bin/uv

ARG NODYRA_UID=10001
ARG NODYRA_GID=10001

# The maintained gosu package includes a patched Go runtime. Shadow supplies
# user/group management used to grant the worker access to a mounted socket.
RUN apk add --no-cache 'gosu>=1.19-r17' shadow \
    && groupadd --gid "${NODYRA_GID}" nodyra \
    && useradd --create-home --uid "${NODYRA_UID}" --gid "${NODYRA_GID}" nodyra

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONPATH=/app/apps/api:/app/packages/core:/app/packages/nodes:/app/packages/exporter:/app/packages/runtime:/app/packages/importer:/app/packages/runner

WORKDIR /app

# Pre-built venv from the installer stage.
COPY --from=builder /app/.venv /app/.venv

# Application source only — no tests, no design files, no CI scripts.
# Paths must match the editable-install .pth pointers left by uv in the venv.
COPY pyproject.toml pyproject.toml
COPY apps/api/app/ apps/api/app/
COPY apps/api/alembic/ apps/api/alembic/
COPY apps/api/alembic.ini apps/api/pyproject.toml apps/api/
COPY packages/client/ packages/client/
COPY packages/core/ packages/core/
COPY packages/nodes/ packages/nodes/
COPY packages/exporter/ packages/exporter/
COPY packages/runtime/ packages/runtime/
COPY packages/importer/ packages/importer/
COPY packages/runner/ packages/runner/
COPY deploy/python-entrypoint.sh deploy/python-entrypoint.sh

RUN mkdir -p /app/envs /app/artifacts \
    && chmod +x /app/deploy/python-entrypoint.sh \
    && chown nodyra:nodyra /app/envs /app/artifacts

ENTRYPOINT ["/app/deploy/python-entrypoint.sh"]

# Liveness probe for the API role. The worker exposes no HTTP port, so it
# disables this in docker-compose (healthcheck.disable: true).
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD gosu nodyra python -c "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=3).status == 200 else 1)"

# Default command is overridden per service in docker-compose.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
