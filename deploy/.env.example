# Nodyra local development environment.
# Copy this file to deploy/.env and fill in real values before running.
# deploy/.env is gitignored and must never be committed.
#
# Generate secure secrets with:
#   NODYRA_SECRET_KEY:    openssl rand -hex 32
#   INTERNAL_API_TOKEN:   openssl rand -hex 32

INTERNAL_API_TOKEN=CHANGE-ME-generate-with-openssl-rand-hex-32
NODYRA_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

# HTTP/database nodes block private, loopback and cloud metadata addresses.
# A trusted, single-tenant installation calling an internal service may opt in
# with 1. Keep 0 for an internet-facing deployment with no internal connectors.
NODYRA_ALLOW_PRIVATE_EGRESS=0

# MinIO object storage credentials (must be ≥ 8 chars)
MINIO_ROOT_USER=nodyra
MINIO_ROOT_PASSWORD=CHANGE-ME-at-least-8-chars

# Compose defaults artifact storage to the bundled MinIO service.
# For external S3-compatible storage, set the bucket/region/endpoint and
# provide AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in deploy/.env.
ARTIFACT_STORAGE_BACKEND=s3
ARTIFACT_S3_BUCKET=nodyra-artifacts
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ENDPOINT=http://minio:9000

# PostgreSQL password for the compose-managed database. Defaults to "nodyra"
# for throwaway dev boxes; set a strong value on any shared or exposed host.
# POSTGRES_PASSWORD=CHANGE-ME

# Override these if your Docker services use different credentials:
# DATABASE_URL=postgresql+asyncpg://nodyra:nodyra@localhost:5432/nodyra
# REDIS_URL=redis://localhost:6379/0

# Optional dispatch-worker capability labels. Queue entries with matching
# required_labels only lease to workers advertising every key/value pair.
# Example: WORKER_LABELS=gpu=a100,mem=high
# WORKER_LABELS=

# Optional runtime-mode diagnostics for horizontally scaled non-Helm deploys.
# Helm sets these automatically from api.replicas and worker.replicas.
# Set them when using docker compose --scale or another orchestrator so
# GET /ops/runtime-mode can flag per-replica fallbacks if Redis is disabled.
# API_REPLICA_COUNT=1
# WORKER_REPLICA_COUNT=1

# Host ports. Change these if something already listens on the default — a
# local PostgreSQL on 5432 is the usual collision. Only the host side moves;
# services still reach each other on the standard ports inside the network.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001
# JAEGER_UI_PORT=16686
# OTEL_HTTP_PORT=4318
# NODYRA_API_PORT=8000
# NODYRA_WEB_PORT=5173
# Exact browser origin for authenticated requests. Change when using a custom
# hostname or NODYRA_WEB_PORT (include https:// for a TLS reverse proxy).
CORS_ORIGINS=http://localhost:5173
# Public HTTPS deployment through Caddy -> web nginx -> API has two proxies.
# Leave 0 for direct local development; configure the actual topology exactly.
TRUSTED_PROXY_COUNT=0
SESSION_COOKIE_SECURE=true
# PUBLIC_API_URL=https://app.your-domain.example/api
# nginx request ceiling; keep above MAX_ARTIFACT_BYTES plus multipart framing.
NODYRA_MAX_BODY_SIZE=52m
