# Nodyra local development environment.
# Copy this file to deploy/.env and fill in real values before running.
# deploy/.env is gitignored and must never be committed.
#
# Generate secure secrets with:
#   NODYRA_SECRET_KEY:    openssl rand -hex 32
#   INTERNAL_API_TOKEN:   openssl rand -hex 32

INTERNAL_API_TOKEN=CHANGE-ME-generate-with-openssl-rand-hex-32
NODYRA_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

# MinIO object storage credentials (must be ≥ 8 chars)
MINIO_ROOT_USER=nodyra
MINIO_ROOT_PASSWORD=CHANGE-ME-at-least-8-chars

# Override these if your Docker services use different credentials:
# DATABASE_URL=postgresql+asyncpg://nodyra:nodyra@localhost:5432/nodyra
# REDIS_URL=redis://localhost:6379/0
