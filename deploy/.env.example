# Nodyra local development environment.
# Copy this file to deploy/.env and fill in real values before running.
# deploy/.env is gitignored and must never be committed.
#
# Generate secure secrets with:
#   NODYRA_SECRET_KEY:    openssl rand -hex 32
#   INTERNAL_API_TOKEN:   openssl rand -hex 32

INTERNAL_API_TOKEN=CHANGE-ME-generate-with-openssl-rand-hex-32
NODYRA_SECRET_KEY=CHANGE-ME-generate-with-openssl-rand-hex-32

# MinIO object storage credentials (must be ≥ 8 chars)
MINIO_ROOT_USER=nodyra
MINIO_ROOT_PASSWORD=CHANGE-ME-at-least-8-chars

# Compose defaults artifact storage to the bundled MinIO service.
# For external S3-compatible storage, set the bucket/region/endpoint and
# provide AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY in deploy/.env.
ARTIFACT_STORAGE_BACKEND=s3
ARTIFACT_S3_BUCKET=nodyra-artifacts
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ENDPOINT=http://minio:9000

# PostgreSQL password for the compose-managed database. Defaults to "nodyra"
# for throwaway dev boxes; set a strong value on any shared or exposed host.
# POSTGRES_PASSWORD=CHANGE-ME

# Override these if your Docker services use different credentials:
# DATABASE_URL=postgresql+asyncpg://nodyra:nodyra@localhost:5432/nodyra
# REDIS_URL=redis://localhost:6379/0

# Optional dispatch-worker capability labels. Queue entries with matching
# required_labels only lease to workers advertising every key/value pair.
# Example: WORKER_LABELS=gpu=a100,mem=high
# WORKER_LABELS=
