      {"id": "e3", "source": "dataset", "source_output": "main", "target": "filter", "target_input": "input"},
      {"id": "e4", "source": "filter", "source_output": "main", "target": "csv", "target_input": "input"},
      {"id": "e5", "source": "filter", "source_output": "main", "target": "preview", "target_input": "input"}
