  "graph": {
    "nodes": [
      {"id": "manual", "type": "manual_trigger", "params": {"data": {}}, "position": {"x": 0, "y": 120}},
      {"id": "sample", "type": "code", "params": {"code": "output = [\n    {'id': 1, 'region': 'west', 'amount': 120},\n    {'id': 2, 'region': 'east', 'amount': 80},\n    {'id': 3, 'region': 'west', 'amount': 240},\n    {'id': 4, 'region': 'north', 'amount': 45},\n]"}, "position": {"x": 260, "y": 120}},
      {"id": "dataset", "type": "records_to_dataset", "params": {}, "position": {"x": 520, "y": 120}},
