# Nodyra configuration. Copy to .env in the repo root for local development.
# Every setting maps to a field on `Settings` in apps/api/app/config.py.
# Anything not set in .env falls back to the code default shown alongside.

# ---- Storage --------------------------------------------------------------
# Use sqlite for a self-hosted single box; switch to postgres for a real deployment.
DATABASE_URL=postgresql+asyncpg://nodyra:nodyra@localhost:5432/nodyra
# DATABASE_URL=sqlite+aiosqlite:///./apps/api/dev.db

# ---- Cache / broker (Redis) ----------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- HTTP / CORS ----------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
# Public API URL used for remote runners and provider webhook callbacks.
# Set this to your externally reachable HTTPS API origin in production.
# PUBLIC_API_URL=https://api.example.com
# MCP_AUTHORIZATION_SERVER_URL=https://identity.example.com
# MCP_OAUTH_INTROSPECTION_URL=https://identity.example.com/oauth2/introspect
# MCP_OAUTH_CLIENT_ID=nodyra-mcp
# MCP_OAUTH_CLIENT_SECRET=replace-me

# ---- Environments (per-workflow Python venvs) ----------------------------
# Directory where uv-managed venvs are built. Relative to the CWD that starts
# the API process (the repo root if you launch uvicorn from there).
ENVS_DIR=./apps/api/envs
# Set false in environments that must never shell out to `uv`.
# ENABLE_VENV_BUILDS=true

# ---- Execution ------------------------------------------------------------
# Dispatch runs to a long-lived per-env subprocess so workflows execute with
# the env's pandas/requests/etc. Required for anything beyond the API's own
# .venv packages.
USE_SUBPROCESS_RUNNER=true
# Warm runner processes kept per environment. Each one re-imports heavy
# packages (pandas etc.), so raise this deliberately when you have RAM.
# RUNNER_POOL_SIZE=1
# Global cap on simultaneously-executing top-level runs. Sub-workflows are
# exempt (they run in-process on the host) so the cap cannot deadlock nested
# runs. Bump higher if you want more parallelism.
# MAX_CONCURRENT_RUNS=8
# Docker-workers autoscaler tick (seconds). The loop adds/removes Docker
# runner containers to match queue depth within each pool's min/max.
# DOCKER_AUTOSCALE_TICK_SECONDS=30
# When true, start_run awaits the run inline. The test suite uses this for
# determinism; leave false in production so the HTTP request returns fast.
# RUN_SYNCHRONOUSLY=false
# Per-node cap for Code nodes (seconds). 0 = uncapped. Default 600.
# CODE_NODE_TIMEOUT_SECONDS=600
# Runtime protocol supervision. The worker emits every 15s and the host retires
# it after 45s without a valid event. Keep timeout greater than interval.
# RUNTIME_HEARTBEAT_INTERVAL_SECONDS=15
# RUNTIME_HEARTBEAT_TIMEOUT_SECONDS=45
# Heartbeats prove liveness but not useful work. Retire a run after this many
# seconds without a non-heartbeat protocol event; 0 disables. Default 900.
# RUNTIME_NO_PROGRESS_TIMEOUT_SECONDS=900
# Optional worker-only OpenMetrics listener.
# WORKER_METRICS_PORT=9401

# OpenTelemetry tracing. Start compose with `--profile observability` to run
# the bundled collector + Jaeger, then set OTEL_ENABLED=true on API/worker.
# OTEL_ENABLED=false
# OTEL_EXPORTER_PROTOCOL=http
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
# Web trace-link target used by the Executions page.
# VITE_TRACE_BASE_URL=http://localhost:16686/trace

# -- Sandboxed execution (container-per-run isolation) ----------------------
# off      = warm subprocess pool (default; trusted single-tenant)
# auto     = hardened containers when a Docker daemon is reachable, else
#            fall back to the subprocess pool with a startup warning
# required = refuse to start without a working daemon + runtime
#            (mandatory when MULTI_TENANCY_ENABLED=true)
# EXECUTION_SANDBOX=auto
# Isolation runtime: auto picks the strongest available (kata > runsc > runc).
# SANDBOX_RUNTIME=auto
# Docker daemon for sandbox containers; empty = DOCKER_HOST / default socket.
# Rootless Podman: unix:///run/user/1000/podman/podman.sock
# SANDBOX_DOCKER_HOST=
# Stable unique worker identity for reclaiming orphaned run containers after a
# restart. Empty uses the hostname; set explicitly for recreated replicas that
# share one daemon, and never share a value between live workers.
# SANDBOX_OWNER_ID=
# Dedicated bridge network for run containers (keeps tenant code away from
# postgres/redis/minio).
# SANDBOX_NETWORK=nodyra-sandbox
# Per-container ceilings.
# SANDBOX_MEM_LIMIT=1g
# SANDBOX_CPU_LIMIT=1.0
# SANDBOX_PIDS_LIMIT=256
# SANDBOX_TMPFS_SIZE=256m
# Warm pool: idle containers kept per (org, env) / globally, TTL, recycle cap.
# SANDBOX_WARM_PER_KEY=1
# SANDBOX_WARM_TOTAL=8
# SANDBOX_WARM_TTL_SECONDS=300
# SANDBOX_MAX_RUNS_PER_CONTAINER=50

# ---- Scheduler ------------------------------------------------------------
# Run the in-process cron loop in this API process. On multi-replica
# deployments set SCHEDULER_ROLE=leader so exactly one replica owns it.
# ENABLE_INPROCESS_SCHEDULER=true
# SCHEDULER_ROLE=inline
# Default timezone for cron expressions when a schedule_trigger / Deployment
# leaves its tz field blank. If unset, the app auto-detects the OS timezone
# at startup (tzlocal). Set explicitly here to pin it across environments.
APP_TIMEZONE=Australia/Sydney

# ---- Run retention --------------------------------------------------------
# Bound the DB as runs accumulate. NodeRun.output and logs are persisted in
# every run, so a high-frequency workflow with chunky outputs would otherwise
# grow without limit.
# Drop runs older than N days (0 disables the age rule).
# RUN_RETENTION_DAYS=14
# Per-workflow cap on retained runs (0 = unlimited count, age-only).
# RUN_RETENTION_MAX_PER_WORKFLOW=0
# Seconds between prune ticks (minimum 60).
# RUN_RETENTION_TICK_SECONDS=3600
# Per-output port size cap in bytes; over-cap values get replaced with a
# {_truncated, size_bytes, preview} stub so one fat DataFrame can't bloat
# the DB. 0 disables.
# MAX_OUTPUT_BYTES=262144

# ---- Audit / SIEM export -------------------------------------------------
# Optional outbound audit webhook. When both URL and secret are set, audit
# events are batched and POSTed as {"type":"audit.batch","events":[...]} with
# X-Nodyra-Signature: sha256=<HMAC-SHA256 body signature>.
# AUDIT_WEBHOOK_URL=https://siem.example.com/nodyra/audit
# AUDIT_WEBHOOK_SECRET=replace-with-random-shared-secret
# AUDIT_WEBHOOK_TIMEOUT_SECONDS=5
# AUDIT_WEBHOOK_BATCH_SIZE=50
# AUDIT_WEBHOOK_QUEUE_SIZE=1000

# ---- Split execution topology (optional) -----------------------------------
# Run the API as a pure control plane and execution on standalone workers:
#   API replicas:  DISPATCH_ROLE=disabled  SCHEDULER_ROLE=leader  QUEUE_BACKEND=redis
#   Workers:       DISPATCH_ROLE=worker    QUEUE_BACKEND=redis    (python -m app.worker_main)
# Both roles need PostgreSQL + Redis. Default (inline) is single-process.
# Note: agent/kubernetes runner pools need a replica with DISPATCH_ROLE=inline
# (their WebSockets terminate on the API); workers run local + docker entries.
# DISPATCH_ROLE=inline
# QUEUE_BACKEND=none
# Shared secret presented on /internal/* calls. Blank = no check (fine if
# only your own machine reaches the API).
# INTERNAL_API_TOKEN=

# ---- Auth -----------------------------------------------------------------
# Set true to require a Bearer token on every non-/auth, non-/health,
# non-/webhook endpoint.
# AUTH_REQUIRED=false
# REPLACE this in any real deployment — JWTs are signed with it.
# SECRET_KEY=change-me-to-a-long-random-string

# ---- Node egress (SSRF) ---------------------------------------------------
# Whether workflow nodes (HTTP Request, integrations, file/RSS fetch, Postgres,
# vector stores, …) may reach private/loopback/link-local hosts and cloud
# metadata (169.254.169.254). Left unset, the default follows the deployment
# model: blocked when MULTI_TENANCY_ENABLED=true (a tenant must never reach
# internal services), allowed for single-tenant self-hosted (so an internal
# database, self-hosted GitLab, or a local Ollama server works). Set explicitly
# to override. LLM provider nodes are exempt — they always honour the model
# endpoint you configure.
# NODYRA_ALLOW_PRIVATE_EGRESS=1

# ---- Signed Community Node Registry ----------------------------------
# Allow browsing and installing packages from the community node registry.
# Set false for air-gapped / maximum-security deployments.
# ALLOW_REGISTRY=true
# URL of the community registry index JSON (default is the official index).
# REGISTRY_INDEX_URL=https://raw.githubusercontent.com/nodyra-registry/packages/main/index.json
# JSON map of publisher key ID to PEM or URL-safe base64 Ed25519 public key.
# REGISTRY_TRUSTED_PUBLISHERS={}
# Development only. Production mode always rejects unverified packages.
# REGISTRY_ALLOW_UNVERIFIED_INSTALL=false
